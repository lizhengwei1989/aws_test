{
  "name": "face-rgb-detector",
  "version": "1.0.0",
  "description": "Vue 3 mobile web app for detecting faces and extracting RGB color values",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "node server.js"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "@mediapipe/face_detection": "^0.4.0",
    "@mediapipe/tasks-vision": "^0.10.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "vue-tsc": "^2.0.0",
    "fast-check": "^3.0.0",
    "jsdom": "^24.0.0"
  }
}
